# 复制为 .env 后填写。不要把真实密钥提交进仓库。
# 视觉模型与品名映射共用这一把密钥。两个名字填一个即可。
# 程序先读 HUNYUAN_API_KEY，为空再读 MOLLI_ARK_API_KEY。
HUNYUAN_API_KEY=
# MOLLI_ARK_API_KEY=

# 可选。不填则用 config/models.json。
# VISION_MODEL=Qwen3.5-Flash
# VISION_API_BASE=https://ai.gitee.com/v1
# MAP_CONFIDENCE=0.8

# 可选。页面里保存的路径优先于这里。
# INPUT_DIR=
# MATERIAL_FILE=
