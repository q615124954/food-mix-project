# 敏感信息（真实密钥，勿提交）
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 运行时状态（自动生成，可删）
webapp/state.json
webapp/state.json.bak
# 本地路径配置（机器相关，勿提交）
webapp/settings.json
# 品名纠错字典（回流学习累积的运行时数据，随使用持续变化）
webapp/product_dict.json
# 品名归并映射表（同步映射，随人工确认持续累积）
webapp/name_map.json
# 品名→物料代码映射表（物料代码主键同步，随确认持续累积）
webapp/code_map.json
# 品名变体表（初始由 name_match.py 的 DEFAULT_VARIANTS 生成，随回流学习累积）
webapp/name_variants.json

# Dify 官方源码子仓库（不属于本采购单工作台项目）
dify/

# 服务运行日志（临时诊断用）
webapp/_uvicorn.log
webapp/_uvicorn.err

# IDE / 系统
.vscode/
.idea/
.codebuddy/
.DS_Store
Thumbs.db

# 公开金标样本（samples/）必须入库。例外放在末尾，避免被前面的宽泛规则盖掉。
!samples/
!samples/**/
!samples/**/*.jpg
!samples/**/*.jpeg
!samples/**/*.xlsx
!samples/**/*.json
!samples/**/*.md
!samples/**/*.py
# 样本目录里跑出来的字节码仍然忽略
samples/**/__pycache__/
samples/**/*.pyc